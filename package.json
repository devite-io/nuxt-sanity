{
  "name": "@devite/nuxt-sanity",
  "version": "2.20.6",
  "description": "Advanced Sanity integration for Nuxt.js.",
  "repository": "devite-io/nuxt-sanity",
  "license": "MIT",
  "author": {
    "name": "Justus Geramb <justus@devite.io>",
    "url": "https://www.devite.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:cms": "cd playground/cms && npm run dev",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "bun run lint && bun run test && bun run prepack && git push && changelogen --release && npm publish --access=public && git push --follow-tags",
    "lint": "eslint --fix .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit"
  },
  "resolutions": {
    "@devite/nuxt-sanity": "link:."
  },
  "build": {
    "externals": [
      "@sanity/client"
    ]
  },
  "dependencies": {
    "@nuxt/image": "^2.2.0",
    "@portabletext/vue": "^2.0.0",
    "@sanity/client": "^8.10.1",
    "@sanity/core-loader": "^2.2.3",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/types": "^6.20.0",
    "@sanity/visual-editing-standalone": "^2.0.2",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1",
    "ohash": "^2.0.12",
    "unstorage": "^1.17.6"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "^3.3.13"
  }
}
